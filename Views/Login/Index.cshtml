@using Harmic.Utilities
<!-- Begin Main Content Area -->
<main class="main-content">
	<div class="breadcrumb-area breadcrumb-height" data-bg-image="/assets/images/breadcrumb/bg/1-1-1920x373.jpg">
		<div class="container h-100">
			<div class="row h-100">
				<div class="col-lg-12">
					<div class="breadcrumb-item">
						<h2 class="breadcrumb-heading">Đăng nhập</h2>
						<ul>
							<li>
								<a href="/home">Trang chủ <i class="pe-7s-angle-right"></i></a>
							</li>
							<li>Đăng nhập</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="login-register-area section-space-y-axis-100">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-6 col-md-8">
					<div class="login-form-wrapper">
						<div class="login-form">
							<div class="login-header text-center mb-5">
								<h3 class="login-title mb-3">Đăng nhập tài khoản</h3>
								<p class="login-subtitle">Chào mừng bạn trở lại! Vui lòng đăng nhập để tiếp tục.</p>
							</div>
							<form id="loginForm" novalidate>
								<div class="row">
									<div class="col-lg-12 mb-4">
										<label class="form-label">Email <span class="text-danger">*</span></label>
										<div class="input-wrapper">
											<i class="pe-7s-mail input-icon input-icon-left"></i>
											<input name="Email" id="Email" type="email" class="form-control" placeholder="Nhập địa chỉ email của bạn" required>
											<div class="invalid-feedback">Vui lòng nhập địa chỉ email hợp lệ</div>
										</div>
									</div>
									<div class="col-lg-12 mb-4">
										<label class="form-label">Mật khẩu <span class="text-danger">*</span></label>
										<div class="input-wrapper">
											<i class="pe-7s-lock input-icon input-icon-left"></i>
											<input name="Password" id="Password" type="password" class="form-control" placeholder="Nhập mật khẩu của bạn" required>
											<span class="password-toggle" id="passwordToggle">
												<i class="pe-7s-look"></i>
											</span>
											<div class="invalid-feedback">Vui lòng nhập mật khẩu</div>
										</div>
									</div>
									<div class="col-lg-12 mb-4">
										<div class="d-flex justify-content-between align-items-center">
											<div class="check-box">
												<input type="checkbox" id="remember_me" name="RememberMe">
												<label for="remember_me">Ghi nhớ đăng nhập</label>
											</div>
											<div class="forgotton-password_info">
												<a href="#" class="text-primary">Quên mật khẩu?</a>
											</div>
										</div>
									</div>
									<div class="col-lg-12 mb-4">
										<button type="submit" class="btn btn-custom-size lg-size btn-secondary btn-primary-hover rounded-0 w-100" id="loginBtn">
											<span class="btn-text">Đăng nhập</span>
											<span class="btn-loading d-none">
												<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
												Đang xử lý...
											</span>
										</button>
									</div>
									<div class="col-lg-12 text-center">
										<p class="register-link mb-0">
											Chưa có tài khoản? <a href="/register" class="text-primary fw-bold">Đăng ký ngay</a>
										</p>
									</div>
								</div>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</main>
<!-- Main Content Area End Here -->

<style>
	.login-form-wrapper {
		background: #fff;
		border-radius: 15px;
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
		padding: 50px 40px;
		margin: 30px 0;
		transition: all 0.3s ease;
	}

	.login-form-wrapper:hover {
		box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15);
	}

	.login-header .login-title {
		font-size: 32px;
		font-weight: 700;
		color: #333;
		margin-bottom: 10px;
	}

	.login-header .login-subtitle {
		color: #666;
		font-size: 15px;
		margin-bottom: 0;
	}

	.form-label {
		font-weight: 600;
		color: #333;
		margin-bottom: 8px;
		font-size: 14px;
		display: block;
	}

	.input-wrapper {
		position: relative;
	}

	.input-wrapper .form-control {
		padding: 14px 15px 14px 45px;
		border: 2px solid #e5e5e5;
		border-radius: 8px;
		font-size: 15px;
		transition: all 0.3s ease;
		height: 50px;
	}

	.input-wrapper #Password {
		padding-right: 45px;
	}

	.input-wrapper .form-control:focus {
		border-color: #bac34e;
		box-shadow: 0 0 0 0.2rem rgba(186, 195, 78, 0.25);
		outline: none;
	}

	.input-wrapper .form-control.is-invalid {
		border-color: #dc3545;
	}

	.input-wrapper .form-control.is-valid {
		border-color: #28a745;
	}

	.input-icon {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		color: #999;
		font-size: 18px;
		pointer-events: none;
		z-index: 5;
	}

	.input-icon-left {
		left: 15px;
	}

	.password-toggle {
		position: absolute;
		right: 15px;
		top: 50%;
		transform: translateY(-50%);
		cursor: pointer;
		color: #999;
		font-size: 18px;
		z-index: 10;
		transition: color 0.3s ease;
	}

	.password-toggle:hover {
		color: #bac34e;
	}

	.check-box {
		display: flex;
		align-items: center;
	}

	.check-box input[type="checkbox"] {
		width: 18px;
		height: 18px;
		margin-right: 8px;
		cursor: pointer;
		accent-color: #bac34e;
	}

	.check-box label {
		margin: 0;
		cursor: pointer;
		color: #666;
		font-size: 14px;
	}

	.forgotton-password_info a {
		font-size: 14px;
		text-decoration: none;
		transition: color 0.3s ease;
	}

	.forgotton-password_info a:hover {
		color: #bac34e !important;
		text-decoration: underline;
	}

	#loginBtn {
		height: 50px;
		font-weight: 600;
		font-size: 16px;
		letter-spacing: 0.5px;
		transition: all 0.3s ease;
		border: none;
	}

	#loginBtn:hover {
		transform: translateY(-2px);
		box-shadow: 0 5px 15px rgba(186, 195, 78, 0.4);
	}

	#loginBtn:disabled {
		opacity: 0.7;
		cursor: not-allowed;
		transform: none;
	}

	.register-link {
		font-size: 14px;
		color: #666;
	}

	.register-link a {
		text-decoration: none;
		transition: color 0.3s ease;
	}

	.register-link a:hover {
		color: #bac34e !important;
		text-decoration: underline;
	}

	.invalid-feedback {
		display: none;
		font-size: 13px;
		margin-top: 5px;
	}

	.form-control.is-invalid ~ .invalid-feedback {
		display: block;
	}

	@@media (max-width: 768px) {
		.login-form-wrapper {
			padding: 35px 25px;
			margin: 20px 0;
		}

		.login-header .login-title {
			font-size: 26px;
		}
	}
</style>

@section Scripts {
	<script>
		$(document).ready(function() {
			// Toggle password visibility
			$('#passwordToggle').on('click', function() {
				var passwordInput = $('#Password');
				var icon = $(this).find('i');
				
				if (passwordInput.attr('type') === 'password') {
					passwordInput.attr('type', 'text');
					icon.removeClass('pe-7s-look').addClass('pe-7s-lock');
				} else {
					passwordInput.attr('type', 'password');
					icon.removeClass('pe-7s-lock').addClass('pe-7s-look');
				}
			});

			// Form validation
			var form = $('#loginForm')[0];
			
			// Real-time validation
			$('#Email, #Password').on('blur', function() {
				validateField(this);
			});

			function validateField(field) {
				var $field = $(field);
				var isValid = field.checkValidity();
				
				if (isValid) {
					$field.removeClass('is-invalid').addClass('is-valid');
				} else {
					$field.removeClass('is-valid').addClass('is-invalid');
				}
			}

			// Form submission
			$('#loginForm').on('submit', function(e) {
				e.preventDefault();
				
				// Validate all fields
				var isValid = true;
				$('#Email, #Password').each(function() {
					validateField(this);
					if (!this.checkValidity()) {
						isValid = false;
					}
				});

				if (!isValid) {
					toastr.error('Vui lòng điền đầy đủ thông tin hợp lệ', 'Lỗi xác thực');
					return;
				}

				// Disable button and show loading
				var $btn = $('#loginBtn');
				$btn.prop('disabled', true);
				$btn.find('.btn-text').addClass('d-none');
				$btn.find('.btn-loading').removeClass('d-none');

				// Get form data - trim both email and password
				var formData = {
					Email: $('#Email').val().trim(),
					Password: $('#Password').val().trim()
				};

				// Submit via AJAX
				$.ajax({
					url: '/Login/Index',
					type: 'POST',
					data: formData,
					headers: {
						'X-Requested-With': 'XMLHttpRequest'
					},
					success: function(response) {
						if (response.success) {
							toastr.success(response.message || 'Đăng nhập thành công!', 'Thành công');
							
							// Redirect after short delay
							setTimeout(function() {
								if (response.redirectUrl) {
									window.location.href = response.redirectUrl;
								} else {
									window.location.href = '/Home';
								}
							}, 1000);
						} else {
							// Show error message
							toastr.error(response.message || 'Đăng nhập thất bại. Vui lòng kiểm tra lại thông tin.', 'Lỗi đăng nhập');
							
							// Re-enable button
							$btn.prop('disabled', false);
							$btn.find('.btn-text').removeClass('d-none');
							$btn.find('.btn-loading').addClass('d-none');
							
							// Highlight error fields
							if (response.fieldErrors) {
								response.fieldErrors.forEach(function(field) {
									$('#' + field).addClass('is-invalid');
								});
							}
						}
					},
					error: function(xhr, status, error) {
						toastr.error('Có lỗi xảy ra. Vui lòng thử lại sau.', 'Lỗi hệ thống');
						
						// Re-enable button
						$btn.prop('disabled', false);
						$btn.find('.btn-text').removeClass('d-none');
						$btn.find('.btn-loading').addClass('d-none');
					}
				});
			});
		});
	</script>
}
