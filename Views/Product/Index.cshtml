@model Harmic.ViewModels.ProductSearchViewModel
@{
    ViewBag.Title = "Danh sách sản phẩm";
    IEnumerable<TbProduct> products = ViewBag.Products;
    int PageNum = ViewBag.PageNum;
    int TotalProducts = ViewBag.TotalProducts;
}
<!-- Begin Main Content Area -->
<main class="main-content">
    <div class="breadcrumb-area breadcrumb-height" data-bg-image="assets/images/breadcrumb/bg/1-1-1920x373.jpg">
        <div class="container h-100">
            <div class="row h-100">
                <div class="col-lg-12">
                    <div class="breadcrumb-item">
                        <h2 class="breadcrumb-heading">Cửa hàng</h2>
                        <ul>
                            <li>
                                <a href="/Home">Trang chủ <i class="pe-7s-angle-right"></i></a>
                            </li>
                            <li>Cửa hàng</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="shop-area section-space-y-axis-100">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 order-lg-1 order-2 pt-10 pt-lg-0">
                    <div class="sidebar-area">
                        <form asp-controller="Product" asp-action="Index">

                            <div class="widgets-searchbox mb-9">
                                <div id="widgets-searchbox">
                                    <input class="input-field" type="text" placeholder="Bạn cần tìm gì?" asp-for="SearchText" value="@Model.SearchText">
                                    <button class="widgets-searchbox-btn" type="submit">
                                        <i class="pe-7s-search"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="widgets-area mb-9">
                                <h2 class="widgets-title mb-5">Tìm kiếm</h2>
                                <div class="widgets-item">
                                    <ul class="widgets-checkbox">
                                        <li>
                                            <input class="input-checkbox" type="checkbox" id="refine-item" asp-for="onSale">
                                            <label class="label-checkbox mb-0" for="refine-item">
                                                Đang giảm giá
                                            </label>
                                        </li>
                                        <li>
                                            <input class="input-checkbox" type="checkbox" id="refine-item-2" asp-for="isNew">
                                            <label class="label-checkbox mb-0" for="refine-item-2">
                                                Sản phẩm mới
                                            </label>
                                        </li>
                                        <li>
                                            <input class="input-checkbox" type="checkbox" id="refine-item-3" asp-for="inStock">
                                            <label class="label-checkbox mb-0" for="refine-item-3">
                                                Còn hàng
                                            </label>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </form>
                        <div class="widgets-area mb-9">
                            <h2 class="widgets-title mb-5">Top Rated Products</h2>
                            <div class="widgets-item">
                                <div class="swiper-container widgets-list-slider">
                                    <div class="swiper-wrapper">
                                        <div class="swiper-slide">
                                            <div class="product-list-item">
                                                <div class="product-img img-zoom-effect">
                                                    <a href="single-product.html">
                                                        <img class="img-full" src="assets/images/product/small-size/1-1-112x124.jpg" alt="Product Images">
                                                    </a>
                                                </div>
                                                <div class="product-content">
                                                    <a class="product-name" href="single-product.html">Dried Lemon Green</a>
                                                    <div class="price-box pb-1">
                                                        <span class="new-price">$80.00</span>
                                                    </div>
                                                    <div class="rating-box-wrap">
                                                        <div class="rating-box">
                                                            <ul>
                                                                <li><i class="pe-7s-star"></i></li>
                                                                <li><i class="pe-7s-star"></i></li>
                                                                <li><i class="pe-7s-star"></i></li>
                                                                <li><i class="pe-7s-star"></i></li>
                                                                <li><i class="pe-7s-star"></i></li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="swiper-slide">
                                            <div class="product-list-item">
                                                <div class="product-img img-zoom-effect">
                                                    <a href="single-product.html">
                                                        <img class="img-full" src="assets/images/product/small-size/1-2-112x124.jpg" alt="Product Images">
                                                    </a>
                                                </div>
                                                <div class="product-content">
                                                    <a class="product-name" href="single-product.html">Natural Coconut</a>
                                                    <div class="price-box pb-1">
                                                        <span class="new-price">$80.00</span>
                                                    </div>
                                                    <div class="rating-box-wrap">
                                                        <div class="rating-box">
                                                            <ul>
                                                                <li><i class="pe-7s-star"></i></li>
                                                                <li><i class="pe-7s-star"></i></li>
                                                                <li><i class="pe-7s-star"></i></li>
                                                                <li><i class="pe-7s-star"></i></li>
                                                                <li><i class="pe-7s-star"></i></li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="swiper-slide">
                                            <div class="product-list-item">
                                                <div class="product-img img-zoom-effect">
                                                    <a href="single-product.html">
                                                        <img class="img-full" src="assets/images/product/small-size/1-3-112x124.jpg" alt="Product Images">
                                                    </a>
                                                </div>
                                                <div class="product-content">
                                                    <a class="product-name" href="single-product.html">Black Peppepr Read</a>
                                                    <div class="price-box pb-1">
                                                        <span class="new-price">$80.00</span>
                                                    </div>
                                                    <div class="rating-box-wrap">
                                                        <div class="rating-box">
                                                            <ul>
                                                                <li><i class="pe-7s-star"></i></li>
                                                                <li><i class="pe-7s-star"></i></li>
                                                                <li><i class="pe-7s-star"></i></li>
                                                                <li><i class="pe-7s-star"></i></li>
                                                                <li><i class="pe-7s-star"></i></li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="widgets-area">
                            <h2 class="widgets-title mb-5">Tag</h2>
                            <div class="widgets-item">
                                <ul class="widgets-tags">
                                    <li>
                                        <a href="javascript:void(0)">Clothing</a>
                                    </li>
                                    <li>
                                        <a href="javascript:void(0)">Accessories</a>
                                    </li>
                                    <li>
                                        <a href="javascript:void(0)">For Men</a>
                                    </li>
                                    <li>
                                        <a href="javascript:void(0)">Women</a>
                                    </li>
                                    <li>
                                        <a href="javascript:void(0)">Fashion</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-9 order-lg-2 order-1">
                    <div class="product-topbar">
                        <ul>
                            <li class="product-view-wrap">
                                <ul class="nav" role="tablist">
                                    <li class="grid-view" role="presentation">
                                        <a id="grid-view-tab" data-bs-toggle="tab" href="#grid-view" role="tab" aria-selected="true">
                                            <i class="fa fa-th"></i>
                                        </a>
                                    </li>
                                    <li class="list-view" role="presentation">
                                        <a class="active" id="list-view-tab" data-bs-toggle="tab" href="#list-view" role="tab" aria-selected="true">
                                            <i class="fa fa-th-list"></i>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="page-count">
                                Tìm được <span>@TotalProducts</span> sản phẩm
                            </li>
                            <li class="short">
                                <select class="nice-select wide rounded-0">
                                    <option value="1">Sort by Default</option>
                                    <option value="2">Sort by Popularity</option>
                                    <option value="3">Sort by Rated</option>
                                    <option value="4">Sort by Latest</option>
                                    <option value="5">Sort by High Price</option>
                                    <option value="6">Sort by Low Price</option>
                                </select>
                            </li>
                        </ul>
                    </div>
                    <div class="tab-content text-charcoal pt-8">
                        <div class="tab-pane fade" id="grid-view" role="tabpanel" aria-labelledby="grid-view-tab">
                            <div class="product-grid-view row">
                                @foreach (var product in products)
                                {
                                    string Url = $"/product/{product.Alias}-{product.ProductId}.html";
                                    <div class="col-lg-4 col-sm-6">
                                        <div class="product-item">
                                            <div class="product-img img-zoom-effect">
                                                <a href="@Url">
                                                    <img class="img-full" src="@product.Image" alt="Product Images">
                                                </a>
                                                <div class="product-add-action">
                                                    <ul>
                                                        <li>
                                                            <a>
                                                                <i class="pe-7s-cart"></i>
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <a href="compare.html">
                                                                <i class="pe-7s-shuffle"></i>
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <a href="wishlist.html">
                                                                <i class="pe-7s-like"></i>
                                                            </a>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                            <div class="product-content">
                                                <a class="product-name" href="@Url">@product.Title</a>
                                                <div class="price-box pb-1">
                                                    @if (product.PriceSale == 0)
                                                    {
                                                        <span class="new-price text-primary">@product.Price</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="old-price text-primary">@product.Price</span>
                                                        <span class="new-price text-danger">@product.PriceSale</span>
                                                    }
                                                </div>
                                                <div class="rating-box">
                                                    <ul>
                                                        @for (int i = 1; i <= product.Star; i++)
                                                        {
                                                            <li><i class="pe-7s-star"></i></li>
                                                        }
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>
                        <div class="tab-pane fade show active" id="list-view" role="tabpanel" aria-labelledby="list-view-tab">
                            <div class="product-list-view with-sidebar row">
                                @foreach (var item in products)
                                {
                                    string Url = $"/product/{item.Alias}-{item.ProductId}.html";
                                    <div class="col-12 pt-6">
                                        <div class="product-item">
                                            <div class="product-img img-zoom-effect">
                                                <a href="@Url">
                                                    <img class="img-full" src="@item.Image" alt="Product Images">
                                                </a>
                                                <div class="product-add-action">
                                                    <ul>
                                                        <li>
                                                            <a href="cart.html">
                                                                <i class="pe-7s-cart"></i>
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <a href="compare.html">
                                                                <i class="pe-7s-shuffle"></i>
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <a href="wishlist.html">
                                                                <i class="pe-7s-like"></i>
                                                            </a>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                            <div class="product-content align-self-center">
                                                <a class="product-name pb-2" href="@Url">@item.Title</a>
                                                <div class="price-box pb-1">
                                                    @if (item.PriceSale == 0)
                                                    {
                                                        <span class="new-price text-primary">@item.Price</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="old-price text-primary">@item.Price</span>
                                                        <span class="new-price text-danger">@item.PriceSale</span>
                                                    }
                                                </div>
                                                <div class="rating-box pb-2">
                                                    <ul>
                                                        @for (int i = 1; i <= item.Star; i++)
                                                        {
                                                            <li><i class="pe-7s-star"></i></li>
                                                        }
                                                    </ul>
                                                </div>
                                                <p class="short-desc mb-0">@item.Description</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    @if(TotalProducts > 0)
                    {
                    <div class="pagination-area pt-10">
                        <nav aria-label="Page navigation example">
                            <ul class="pagination justify-content-center">
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-route-CategoryId="@Model.CategoryId" asp-route-Page="@(Model.Page > 1 ? Model.Page - 1 : 1)" asp-route-SearchText="@Model.SearchText" asp-route-onSale="@Model.onSale" asp-route-isNew="@Model.isNew" asp-route-inStock="@Model.inStock" aria-label="Previous">
                                        <span class="fa fa-chevron-left"></span>
                                    </a>
                                </li>
                                @for (int i = 1; i <= PageNum; i++)
                                {
                                    <li class="page-item @(Model.Page == i ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-CategoryId="@Model.CategoryId" asp-route-Page="@i" asp-route-SearchText="@Model.SearchText" asp-route-onSale="@Model.onSale" asp-route-isNew="@Model.isNew" asp-route-inStock="@Model.inStock">@i</a></li>
                                }
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-route-CategoryId="@Model.CategoryId" asp-route-Page="@(Model.Page<PageNum? Model.Page + 1 : PageNum)" asp-route-SearchText="@Model.SearchText" asp-route-onSale="@Model.onSale" asp-route-isNew="@Model.isNew" asp-route-inStock="@Model.inStock" aria-label="Next">
                                        <span class="fa fa-chevron-right"></span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                    }
                </div>
            </div>
        </div>
    </div>
</main>
<!-- Main Content Area End Here -->
