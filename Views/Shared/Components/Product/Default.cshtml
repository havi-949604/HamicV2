@model IEnumerable<Harmic.Models.TbProduct>
@using Harmic.Utilities;
@if (ViewBag.CategoryID.ToString() == "All")
{
    foreach (var item in Model.Take(8))
    {
        string sURL = $"/product/{item.Alias}-{item.ProductId}.html";
        <div class="col-xl-3 col-lg-4 col-sm-6">
            <div class="product-item">
                <div class="product-img img-zoom-effect position-relative">
                    <a href="@sURL">
                        <img class="img-full" src="@item.Image" alt="Product Images">
                    </a>
                    @if (Function.IsProductOnSale(item))
                    {
                        var discountPercent = (int)(((decimal)(item.Price ?? 0) - (decimal)(item.PriceSale ?? 0)) / (decimal)(item.Price ?? 1) * 100);
                        <span class="product-badge position-absolute top-0 end-0 bg-danger text-white px-2 py-1" style="font-size: 12px; font-weight: 600; z-index: 10; border-radius: 0 0 0 8px;">
                            -@discountPercent%
                        </span>
                        @if (item.SaleEndDate.HasValue)
                        {
                            <span class="sale-end-date position-absolute bottom-0 start-0 bg-warning text-dark px-2 py-1" style="font-size: 10px; font-weight: 500; z-index: 10; border-radius: 0 8px 0 0;">
                                Kết thúc: @item.SaleEndDate.Value.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        }
                    }
                    <div class="product-add-action">
                        <ul>
                            <li>
                                <a href="javascript:void(0)" class="add-to-cart-link" data-product-id="@item.ProductId" data-url="/Home">
                                    <i class="pe-7s-cart"></i>
                                </a>
                            </li>
                            <li>
                                <a href="compare.html">
                                    <i class="pe-7s-shuffle"></i>
                                </a>
                            </li>
                            <li>
                                <a href="javascript:void(0)" class="wishlist-toggle-link" data-product-id="@item.ProductId" data-url="/Home">
                                    <i class="pe-7s-like" style="@(item.TbWishlishes.Where(i => i.AccountId == Function._AccountId && i.ProductId == item.ProductId).Count() != 0 ? "color: red" : "")"></i>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="product-content">
                    <a class="product-name" href="@sURL">@item.Title</a>
                    <div class="price-box pb-1">
                        @if (Function.IsProductOnSale(item))
                        {
                            <span class="old-price text-primary">@item.Price</span>
                            <span class="new-price text-danger">@Function.GetCurrentPrice(item)</span>
                        }
                        else
                        {
                            <span class="new-price text-primary">@Function.GetCurrentPrice(item)</span>
                        }
                    </div>
                    <div class="rating-box star">
                        <ul>
                            @for (int i = 0; i < item.Star; i++)
                            {
                                <i class="fa fa-star" aria-hidden="true"></i>
                            }
                            @for (int i = 0; i < 5 - item.Star; i++)
                            {
                                <i class="fa fa-star-o" aria-hidden="true"></i>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    foreach (var item in Model.Where(m => m.CategoryProductId.ToString() == ViewBag.CategoryID))
    {
        string sURL = $"/product/{item.Alias}-{item.ProductId}.html";
        <div class="col-xl-3 col-lg-4 col-sm-6">
            <div class="product-item">
                <div class="product-img img-zoom-effect position-relative">
                    <a href="@sURL">
                        <img class="img-full" src="@item.Image" alt="Product Images">
                    </a>
                    @if (Function.IsProductOnSale(item))
                    {
                        var discountPercent = (int)(((decimal)(item.Price ?? 0) - (decimal)(item.PriceSale ?? 0)) / (decimal)(item.Price ?? 1) * 100);
                        <span class="product-badge position-absolute top-0 end-0 bg-danger text-white px-2 py-1" style="font-size: 12px; font-weight: 600; z-index: 10; border-radius: 0 0 0 8px;">
                            -@discountPercent%
                        </span>
                        @if (item.SaleEndDate.HasValue)
                        {
                            <span class="sale-end-date position-absolute bottom-0 start-0 bg-warning text-dark px-2 py-1" style="font-size: 10px; font-weight: 500; z-index: 10; border-radius: 0 8px 0 0;">
                                Kết thúc: @item.SaleEndDate.Value.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        }
                    }
                    <div class="product-add-action">
                        <ul>
                            <li>
                                <a href="javascript:void(0)" class="add-to-cart-link" data-product-id="@item.ProductId" data-url="/Home">
                                    <i class="pe-7s-cart"></i>
                                </a>
                            </li>
                            <li>
                                <a href="compare.html">
                                    <i class="pe-7s-shuffle"></i>
                                </a>
                            </li>
                            <li>
                                <a href="javascript:void(0)" class="wishlist-toggle-link" data-product-id="@item.ProductId" data-url="/Home">
                                    <i class="pe-7s-like" style="@(item.TbWishlishes.Where(i => i.AccountId == Function._AccountId && i.ProductId == item.ProductId).Count() != 0 ? "color: red" : "")"></i>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="product-content">
                    <a class="product-name" href="@sURL">@item.Title</a>
                    <div class="price-box pb-1">
                        @if (Function.IsProductOnSale(item))
                        {
                            <span class="old-price text-primary">@item.Price</span>
                            <span class="new-price text-danger">@Function.GetCurrentPrice(item)</span>
                        }
                        else
                        {
                            <span class="new-price text-primary">@Function.GetCurrentPrice(item)</span>
                        }
                    </div>
                    <div class="rating-box">
                        <ul>
                            @for (int i = 0; i != item.Star; i++)
                            {
                                <li><i class="pe-7s-star"></i></li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
}