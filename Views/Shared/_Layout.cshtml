    @if (!string.IsNullOrEmpty(Function._Message))
    {
        var message = Function._Message;
        var messageType = "info";
        Function._Message = string.Empty;
        
        if (message.Contains("thành công") || message.Contains("success"))
        {
            messageType = "success";
        }
        else if (message.Contains("lỗi") || message.Contains("error") || message.Contains("thất bại") || message.Contains("không có quyền"))
        {
            messageType = "error";
        }
        else if (message.Contains("cảnh báo") || message.Contains("warning"))
        {
            messageType = "warning";
        }
        
        <script>
            $(document).ready(function() {
                var message = '@Html.Raw(JavaScriptEncoder.Default.Encode(message))';
                var messageType = '@messageType';
                
                if (messageType === 'success') {
                    toastr.success(message, 'Thành công');
                } else if (messageType === 'error') {
                    toastr.error(message, 'Thông báo');
                } else if (messageType === 'warning') {
                    toastr.warning(message, 'Cảnh báo');
                } else {
                    toastr.info(message, 'Thông báo');
                }
            });
        </script>
    }

