@model Harmic.ViewModels.BlogSearchViewModel
@{
    IEnumerable<TbBlog> blogs = ViewBag.Blogs;
    IEnumerable<TbCategory> categories = ViewBag.Categories;
    int pageNum = ViewBag.PageNum;
}
<!-- Begin Main Content Area -->
<main class="main-content">
    <div class="breadcrumb-area breadcrumb-height" data-bg-image="assets/images/breadcrumb/bg/1-1-1920x373.jpg">
        <div class="container h-100">
            <div class="row h-100">
                <div class="col-lg-12">
                    <div class="breadcrumb-item">
                        <h2 class="breadcrumb-heading">Blog Layout</h2>
                        <ul>
                            <li>
                                <a href="index.html">Home <i class="pe-7s-angle-right"></i></a>
                            </li>
                            <li>Blog Left Sidebar</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="blog-area section-space-y-axis-100">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 order-lg-1 order-2 pt-10 pt-lg-0">
                    <div class="sidebar-area">
                        <form asp-controller="blog" asp-action="index" method="post">
                        <div class="widgets-searchbox mb-9">
                            <div id="widgets-searchbox" action="#">
                                <input class="input-field" type="text" placeholder="Search">
                                <button class="widgets-searchbox-btn" type="submit">
                                    <i class="pe-7s-search"></i>
                                </button>
                            </div>
                        </div>
                        <div class="widgets-area mb-9">
                            <h2 class="widgets-title mb-5">Sắp xếp theo</h2>
                            <div class="widgets-item">
                                <ul class="widgets-category">
                                    <li>
                                        <input type="radio" asp-for="SortBy" name="SortBy" value="NewFirst" /> Mới nhất xếp trước
                                    </li>
                                    <li>
                                        <input type="radio" asp-for="SortBy" name="SortBy" value="ProminentFirst" /> Nổi bật xếp trước
                                    </li>
                                </ul>
                            </div>
                            <h2 class="widgets-title mb-5 mt-5">Danh mục</h2>
                            <div class="widgets-item">
                                <ul class="widgets-category">
                                    <li>
                                            <input type="radio" asp-for="CategoryId" name="CategoryId" value="0" /> Tất cả
                                    </li>
                                    @foreach (var item in categories)
                                    {
                                        <li>
                                                <input type="radio" asp-for="CategoryId" name="CategoryId" value="@item.CategoryId" /> @item.Title
                                        </li>
                                    }

                                </ul>
                            </div>
                        </div>
                        </form>
                        <div class="widgets-area mb-9">
                            <h2 class="widgets-title mb-5">Top Rated Products</h2>
                            <div class="widgets-item">
                                <div class="swiper-container widgets-list-slider style-2">
                                    <div class="swiper-wrapper">
                                        <div class="swiper-slide">
                                            <div class="product-list-item">
                                                <div class="product-img img-zoom-effect">
                                                    <a href="single-product.html">
                                                        <img class="img-full" src="assets/images/blog/small-size/1-1-86x86.jpg" alt="Blog Images">
                                                    </a>
                                                </div>
                                                <div class="product-content">
                                                    <h5 class="title mb-3">
                                                        <a href="blog-detail-left-sidebar.html">Lorem ipsum dolor sit amet consecte</a>
                                                    </h5>
                                                    <div class="blog-meta text-manatee pb-1">
                                                        <ul>
                                                            <li class="date">May 21, 2021</li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="swiper-slide">
                                            <div class="product-list-item">
                                                <div class="product-img img-zoom-effect">
                                                    <a href="single-product.html">
                                                        <img class="img-full" src="assets/images/blog/small-size/1-2-86x86.jpg" alt="Blog Images">
                                                    </a>
                                                </div>
                                                <div class="product-content">
                                                    <h5 class="title mb-3">
                                                        <a href="blog-detail-left-sidebar.html">Lorem ipsum dolor sit amet consecte</a>
                                                    </h5>
                                                    <div class="blog-meta text-manatee pb-1">
                                                        <ul>
                                                            <li class="date">May 21, 2021</li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="swiper-slide">
                                            <div class="product-list-item">
                                                <div class="product-img img-zoom-effect">
                                                    <a href="single-product.html">
                                                        <img class="img-full" src="assets/images/blog/small-size/1-3-86x86.jpg" alt="Blog Images">
                                                    </a>
                                                </div>
                                                <div class="product-content">
                                                    <h5 class="title mb-3">
                                                        <a href="blog-detail-left-sidebar.html">Lorem ipsum dolor sit amet consecte</a>
                                                    </h5>
                                                    <div class="blog-meta text-manatee pb-1">
                                                        <ul>
                                                            <li class="date">May 21, 2021</li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="widgets-area">
                            <h2 class="widgets-title mb-5">Tag</h2>
                            <div class="widgets-item">
                                <ul class="widgets-tags">
                                    <li>
                                        <a href="javascript:void(0)">Clothing</a>
                                    </li>
                                    <li>
                                        <a href="javascript:void(0)">Accessories</a>
                                    </li>
                                    <li>
                                        <a href="javascript:void(0)">For Men</a>
                                    </li>
                                    <li>
                                        <a href="javascript:void(0)">Women</a>
                                    </li>
                                    <li>
                                        <a href="javascript:void(0)">Fashion</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-9 order-lg-2 order-1">
                    <div class="blog-item-wrap row">
                        @foreach (var item in blogs)
                        {
                            string Url = $"/blog/{item.Alias}-{item.BlogId}.html";
                            <div class="col-md-6">
                                <div class="blog-item">
                                    <div class="blog-img img-zoom-effect">
                                        <a href="blog-detail-left-sidebar.html">
                                            <img class="img-full" src="@item.Image" alt="@item.Title">
                                        </a>
                                    </div>
                                    <div class="blog-content">
                                        <div class="blog-meta text-dim-gray pb-3">
                                            <ul>
                                                <li class="date"><i class="fa fa-calendar-o me-2"></i>@item.CreatedDate</li>
                                                <li>
                                                    <span class="comments me-3">
                                                        <a href="javascript:void(0)">@item.TbBlogcomments.Count() bình luận</a>
                                                    </span>
                                                    <span class="link-share">
                                                        <a href="javascript:void(0)">Chia sẻ</a>
                                                    </span>
                                                </li>
                                            </ul>
                                        </div>
                                        <h5 class="title mb-4">
                                            <a href="@Url">@item.Title</a>
                                        </h5>
                                        <p class="short-desc mb-5">@item.Description</p>
                                        <div class="button-wrap">
                                            <a class="btn btn-custom-size lg-size btn-dark rounded-0" href="@Url">Đọc bài viết</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="col-lg-12">
                            <div class="pagination-area pt-10">
                                <nav aria-label="Page navigation example">
                                    <ul class="pagination justify-content-center">
                                        <li class="page-item">
                                            <a class="page-link" asp-action="Index" asp-route-CategoryId="@Model.CategoryId" asp-route-Page="@(Model.Page > 1 ? Model.Page - 1 : 1)" asp-route-SearchText="@Model.SearchText" asp-route-SortBy="@Model.SortBy" aria-label="Previous">
                                                <span class="fa fa-chevron-left"></span>
                                            </a>
                                        </li>
                                        @for (int i = 1; i <= pageNum; i++)
                                        {
                                            <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-CategoryId="@Model.CategoryId" asp-route-Page="@i" asp-route-SearchText="@Model.SearchText" asp-route-SortBy="@Model.SortBy">@i</a></li>
                                        }
                                        <li class="page-item">
                                            <a class="page-link" asp-action="Index" asp-route-CategoryId="@Model.CategoryId" asp-route-Page="@(Model.Page < pageNum ? Model.Page + 1 : pageNum)" asp-route-SearchText="@Model.SearchText" asp-route-SortBy="@Model.SortBy" aria-label="Next">
                                                <span class="fa fa-chevron-right"></span>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
<!-- Main Content Area End Here -->