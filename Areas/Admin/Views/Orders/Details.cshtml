@model Harmic.Models.TbOrder
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewBag.active = "Orders";
}

<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Chi tiết đơn hàng</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Home">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a href="/Admin/Orders">Đơn hàng</a></li>
                        <li class="breadcrumb-item active">Chi tiết</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Thông tin đơn hàng #@Model.Code</h3>
                        </div>
                        <div class="card-body">
                            <!-- Thông tin khách hàng -->
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <h5>Thông tin khách hàng</h5>
                                    <table class="table table-bordered">
                                        <tr>
                                            <th width="40%">Tên khách hàng:</th>
                                            <td>@Html.DisplayFor(model => model.CustomerName)</td>
                                        </tr>
                                        <tr>
                                            <th>Số điện thoại:</th>
                                            <td>@Html.DisplayFor(model => model.Phone)</td>
                                        </tr>
                                        <tr>
                                            <th>Địa chỉ:</th>
                                            <td>@Html.DisplayFor(model => model.Address)</td>
                                        </tr>
                                        @if (Model.Customer != null && Model.Customer.Email != null)
                                        {
                                            <tr>
                                                <th>Email:</th>
                                                <td>@Html.DisplayFor(model => model.Customer.Email)</td>
                                            </tr>
                                        }
                                    </table>
                                </div>
                                <div class="col-md-6">
                                    <h5>Thông tin đơn hàng</h5>
                                    <table class="table table-bordered">
                                        <tr>
                                            <th width="40%">Mã đơn hàng:</th>
                                            <td><strong>@Html.DisplayFor(model => model.Code)</strong></td>
                                        </tr>
                                        <tr>
                                            <th>Trạng thái:</th>
                                            <td>
                                                @if (Model.OrderStatus != null)
                                                {
                                                    <span class="badge badge-info">@Model.OrderStatus.Name</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">Chưa xác định</span>
                                                }
                                            </td>
                                        </tr>
                                        <tr>
                                            <th>Ngày đặt:</th>
                                            <td>@(Model.CreatedDate?.ToString("dd/MM/yyyy HH:mm"))</td>
                                        </tr>
                                        <tr>
                                            <th>Tổng tiền:</th>
                                            <td><strong class="text-danger">@string.Format("{0:N0}", Model.TotalAmount) đ</strong></td>
                                        </tr>
                                        <tr>
                                            <th>Số lượng sản phẩm:</th>
                                            <td>@Html.DisplayFor(model => model.Quanlity)</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- Chi tiết sản phẩm -->
                            <h5>Chi tiết sản phẩm</h5>
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Mã sản phẩm</th>
                                        <th>Tên sản phẩm</th>
                                        <th>Giá</th>
                                        <th>Số lượng</th>
                                        <th>Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int index = 1;
                                        var productsDict = ViewBag.Products as Dictionary<int, Harmic.Models.TbProduct>;
                                    }
                                    @foreach (var detail in Model.TbOrderdetails)
                                    {
                                        Harmic.Models.TbProduct? product = null;
                                        if (detail.ProductId.HasValue && productsDict != null && productsDict.ContainsKey(detail.ProductId.Value))
                                        {
                                            product = productsDict[detail.ProductId.Value];
                                        }
                                        <tr>
                                            <td>@(index++)</td>
                                            <td>@detail.ProductId</td>
                                            <td>
                                                @if (product != null)
                                                {
                                                    <a href="/product/@(product.Alias)-@(product.ProductId).html" target="_blank">
                                                        @product.Title
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Sản phẩm không tồn tại</span>
                                                }
                                            </td>
                                            <td>@string.Format("{0:N0}", detail.Price) đ</td>
                                            <td>@detail.Quantity</td>
                                            <td><strong>@string.Format("{0:N0}", (detail.Price * detail.Quantity)) đ</strong></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th colspan="5" class="text-right">Tổng cộng:</th>
                                        <th class="text-danger">@string.Format("{0:N0}", Model.TotalAmount) đ</th>
                                    </tr>
                                </tfoot>
                            </table>

                            <div class="mt-3">
                                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                                <a asp-action="Edit" asp-route-id="@Model.OrderId" class="btn btn-primary">Cập nhật trạng thái</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

