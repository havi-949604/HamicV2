@model Harmic.Models.TbPermission

@{
    ViewData["Title"] = "Thêm quyền";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewBag.active = "Permissions";
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Thêm quyền mới</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Home">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a href="/Admin/Permissions">Quản lý quyền</a></li>
                        <li class="breadcrumb-item active">Thêm quyền</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title">Thông tin quyền</h3>
                        </div>
                        <form asp-action="Create">
                            <div class="card-body">
                                <div class="form-group">
                                    <label asp-for="PermissionName" class="control-label">Tên quyền</label>
                                    <input asp-for="PermissionName" class="form-control" placeholder="Ví dụ: Quản lý sản phẩm" />
                                    <span asp-validation-for="PermissionName" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Description" class="control-label">Mô tả</label>
                                    <input asp-for="Description" class="form-control" placeholder="Mô tả về quyền này" />
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="ControllerName" class="control-label">Controller</label>
                                            <select asp-for="ControllerName" id="controllerSelect" class="form-control">
                                                <option value="">-- Chọn Controller --</option>
                                                @if (ViewBag.Controllers != null)
                                                {
                                                    @foreach (var controller in ViewBag.Controllers as List<string>)
                                                    {
                                                        <option value="@controller">@controller</option>
                                                    }
                                                }
                                            </select>
                                            <span asp-validation-for="ControllerName" class="text-danger"></span>
                                            <small class="form-text text-muted">Chọn controller từ danh sách</small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="ActionName" class="control-label">Action</label>
                                            <select asp-for="ActionName" id="actionSelect" class="form-control" disabled>
                                                <option value="">-- Chọn Controller trước --</option>
                                            </select>
                                            <span asp-validation-for="ActionName" class="text-danger"></span>
                                            <small class="form-text text-muted">Chọn action từ danh sách</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" checked="checked" />
                                    <label class="form-check-label" asp-for="IsActive">Hoạt động</label>
                                </div>
                            </div>
                            <div class="card-footer">
                                <button type="submit" class="btn btn-primary">Thêm quyền</button>
                                <a href="/Admin/Permissions" class="btn btn-secondary">Hủy</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            var controllersAndActions = @Html.Raw(ViewBag.ControllersAndActions != null ? System.Text.Json.JsonSerializer.Serialize(ViewBag.ControllersAndActions) : "{}");

            // Khi chọn controller, load actions tương ứng
            $('#controllerSelect').on('change', function() {
                var controllerName = $(this).val();
                var actionSelect = $('#actionSelect');
                
                if (controllerName) {
                    // Load actions từ server
                    $.get('/Admin/Permissions/GetActions', { controllerName: controllerName }, function(actions) {
                        actionSelect.empty();
                        actionSelect.append('<option value="">-- Chọn Action --</option>');
                        
                        if (actions && actions.length > 0) {
                            $.each(actions, function(index, action) {
                                actionSelect.append('<option value="' + action + '">' + action + '</option>');
                            });
                            actionSelect.prop('disabled', false);
                        } else {
                            actionSelect.append('<option value="">Không có action nào</option>');
                            actionSelect.prop('disabled', true);
                        }
                    });
                    
                    // Tự động điền tên quyền
                    autoFillPermissionName(controllerName);
                } else {
                    actionSelect.empty();
                    actionSelect.append('<option value="">-- Chọn Controller trước --</option>');
                    actionSelect.prop('disabled', true);
                }
            });

            // Khi chọn action, cập nhật tên quyền
            $('#actionSelect').on('change', function() {
                var controllerName = $('#controllerSelect').val();
                var actionName = $(this).val();
                if (controllerName && actionName) {
                    autoFillPermissionName(controllerName, actionName);
                }
            });

            function autoFillPermissionName(controllerName, actionName) {
                var permissionNameField = $('#PermissionName');
                
                // Chỉ tự động điền nếu field trống
                if (!permissionNameField.val() || permissionNameField.val().trim() === '') {
                    var name = controllerName;
                    if (actionName && actionName !== 'Index') {
                        name += ' - ' + actionName;
                    }
                    permissionNameField.val(name);
                }
            }
        });
    </script>
}

