@model IEnumerable<Harmic.Models.TbProduct>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewBag.active = "Products";

}

<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Quản lý sản phẩm</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active">Simple Tables</li>
                    </ol>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><a asp-action="Create">Thêm mới</a></h3>
                        </div>
                        <!-- /.card-header -->
                        <div class="card-body">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Tên</th>
                                        <th>Danh mục</th>
                                        <th>Giá</th>
                                        <th>Khuyến mãi</th>
                                        <th>Ảnh</th>
                                        <th>Tồn kho</th>
                                        <th>Đã bán</th>
                                        <th>Hiện</th>
                                        <th>Hành động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int i = 1;
                                        var soldQuantities = ViewBag.SoldQuantities as Dictionary<int?, int>;
                                        foreach (var item in Model)
                                        {
                                            string url = $"/product/{item.Alias}-{item.ProductId}.html";
                                            int soldQuantity = 0;
                                            if (soldQuantities != null && item.ProductId != null && soldQuantities.ContainsKey(item.ProductId))
                                            {
                                                soldQuantity = soldQuantities[item.ProductId];
                                            }
                                            <tr>
                                                <td>@(i++)</td>
                                                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                                                <td>@Html.DisplayFor(modelItem => item.CategoryProduct.Title)</td>
                                                <td>@Html.DisplayFor(modelItem => item.Price)</td>
                                                <td>@(item.PriceSale == 0 ? "Không khuyến mãi" : item.PriceSale)</td>
                                                <td><img src="@Html.DisplayFor(modelItem => item.Image)" width="50" height="50" /></td>
                                                <td>
                                                    @{
                                                        var stock = item.UnitInStock ?? 0;
                                                        var stockClass = stock <= 10 ? "text-danger font-weight-bold" : (stock <= 50 ? "text-warning" : "text-success");
                                                    }
                                                    <span class="@stockClass">@stock</span>
                                                </td>
                                                <td>
                                                    <span class="text-info font-weight-bold">@soldQuantity</span>
                                                </td>
                                                <td>
                                                    @if (item.IsActive)
                                                    {
                                                        <a asp-action="ChangeShow" asp-route-id="@item.ProductId" class="btn btn-primary"><i class="fas fa-eye"></i></a>
                                                    }
                                                    else
                                                    {
                                                        <a asp-action="ChangeShow" asp-route-id="@item.ProductId" class="btn btn-warning"><i class="fas fa-eye-slash"></i></a>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="btn-group" role="group">
                                                        <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-primary">Sửa</a>
                                                        <a href="@url" class="btn btn-info">Xem</a>
                                                        <form id="deleteForm_@item.ProductId" asp-action="Delete" asp-route-id="@item.ProductId" method="post" style="display: inline;">
                                                            @Html.AntiForgeryToken()
                                                            <button type="button" class="btn btn-danger delete-btn" data-product-id="@item.ProductId" data-product-title="@(item.Title ?? "")">Xóa</button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        <!-- /.card-body -->
                        <div class="card-footer clearfix">
                            <ul class="pagination pagination-sm m-0 float-right">
                                <li class="page-item"><a class="page-link" href="#">&laquo;</a></li>
                                <li class="page-item"><a class="page-link" href="#">1</a></li>
                                <li class="page-item"><a class="page-link" href="#">2</a></li>
                                <li class="page-item"><a class="page-link" href="#">3</a></li>
                                <li class="page-item"><a class="page-link" href="#">&raquo;</a></li>
                            </ul>
                        </div>
                    </div>
                    <!-- /.card -->

                </div>

            </div>


        </div><!-- /.container-fluid -->
    </section>
    <!-- /.content -->
</div>

<!-- Modal xác nhận xóa -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Xác nhận xóa</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn xóa sản phẩm <strong id="deleteProductName"></strong>?</p>
                <p class="text-danger"><small>Hành động này không thể hoàn tác!</small></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Xóa</button>
            </div>
        </div>
    </div>
</div>

<script>
    var deleteProductId = null;
    
    document.addEventListener('DOMContentLoaded', function() {
        var deleteButtons = document.querySelectorAll('.delete-btn');
        deleteButtons.forEach(function(button) {
            button.addEventListener('click', function() {
                deleteProductId = this.getAttribute('data-product-id');
                var productTitle = this.getAttribute('data-product-title');
                document.getElementById('deleteProductName').textContent = '"' + productTitle + '"';
                $('#deleteModal').modal('show');
            });
        });
        
        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            if (deleteProductId) {
                document.getElementById('deleteForm_' + deleteProductId).submit();
            }
        });
    });
</script>