@model Harmic.Models.TbProduct

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewBag.active = "Products";

}

<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Sửa sản phẩm</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Trang chủ</a></li>
                        <li class="breadcrumb-item active">Chỉnh sửa sản phẩm</li>
                    </ol>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <!-- left column -->
                <div class="col-md-12">
                    <!-- general form elements -->
                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title">Sửa sản phẩm</h3>
                        </div>
                        <!-- /.card-header -->
                        <!-- form start -->
                        <form asp-action="Edit">
                            <input type="hidden" asp-for="ProductId">
                            <input type="hidden" asp-for="Alias">
                            <input type="hidden" asp-for="CreatedBy">
                            <input type="hidden" asp-for="CreatedDate">
                            <div class="card-body">
                                <div class="form-group">
                                    <label asp-for="Title" class="control-label">Tiêu đề</label>
                                    <input asp-for="Title" class="form-control">
                                    <span asp-validation-for="Title" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="CategoryProductId" class="control-label">Danh mục</label>
                                    <select asp-for="CategoryProductId" class="form-control" asp-items="ViewBag.CategoryProductId">
                                        <option value="0" selected>--[Chọn danh mục]--</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Description" class="control-label">Mô tả</label>
                                    <input asp-for="Description" class="form-control">
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Detail" class="control-label">Chi tiết</label>
                                    <textarea asp-for="Detail" class="form-control"></textarea>
                                    <span asp-validation-for="Detail" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Image" class="control-label">Ảnh</label>
                                    <div class="input-group mb-3">
                                        <div class="input-group-prepend">
                                            <button type="button" class="btn btn-success" onclick="openDialog()">Chọn ảnh</button>
                                        </div>
                                        <input type="text" class="form-control" id="file_input" asp-for="Image" aria-describedby="button-addon2">
                                    </div>
                                    <span asp-validation-for="Image" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Price" class="control-label">Giá</label>
                                    <input asp-for="Price" class="form-control">
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="PriceSale" class="control-label">Giá khuyến mãi</label>
                                    <input asp-for="PriceSale" class="form-control" type="number" min="0">
                                    <span asp-validation-for="PriceSale" class="text-danger"></span>
                                    <small class="form-text text-muted">Để trống nếu không có khuyến mãi</small>
                                </div>
                                <div class="form-group">
                                    <label class="control-label">Chương trình khuyến mãi</label>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <label asp-for="SaleStartDate" class="control-label">Ngày bắt đầu khuyến mãi</label>
                                            <input asp-for="SaleStartDate" class="form-control" type="datetime-local" value="@(Model.SaleStartDate?.ToString("yyyy-MM-ddTHH:mm"))">
                                            <span asp-validation-for="SaleStartDate" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="SaleEndDate" class="control-label">Ngày kết thúc khuyến mãi</label>
                                            <input asp-for="SaleEndDate" class="form-control" type="datetime-local" value="@(Model.SaleEndDate?.ToString("yyyy-MM-ddTHH:mm"))">
                                            <span asp-validation-for="SaleEndDate" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <small class="form-text text-muted">Nếu có giá khuyến mãi, vui lòng nhập ngày bắt đầu và kết thúc. Sau ngày kết thúc, giá sẽ tự động quay về giá gốc.</small>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Quantity" class="control-label">Số lượng</label>
                                    <input asp-for="Quantity" class="form-control">
                                    <span asp-validation-for="Quantity" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="UnitInStock" class="control-label">Tồn kho</label>
                                    <input asp-for="UnitInStock" class="form-control">
                                    <span asp-validation-for="UnitInStock" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Star" class="control-label">Sao</label>
                                    <input asp-for="Star" class="form-control">
                                    <span asp-validation-for="Star" class="text-danger"></span>
                                </div>

                                <div class="form-check form-group">
                                    <label class="form-check-label">
                                        <input class="form-check-input" asp-for="IsNew" />Là sản phẩm mới
                                    </label>
                                </div>
                                <div class="form-check form-group">
                                    <label class="form-check-label">
                                        <input class="form-check-input" asp-for="IsBestSeller" />Bán chạy
                                    </label>
                                </div>
                                <div class="form-check form-group">
                                    <label class="form-check-label">
                                        <input class="form-check-input" asp-for="IsActive" />Hiển thị
                                    </label>
                                </div>
                            </div>
                            <!-- /.card-body -->

                            <div class="card-footer">
                                <button type="submit" class="btn btn-primary">Sửa</button>
                            </div>
                        </form>
                    </div>
                </div>
                <!--/.col (left) -->
            </div>
            <!-- /.row -->
        </div><!-- /.container-fluid -->
    </section>
    <!-- /.content -->
</div>

@{
    var summerNote = new Harmic.Areas.Admin.Models.SummerNote("#Detail");
    <partial name="_SummerNote" model="summerNote" />
}
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}