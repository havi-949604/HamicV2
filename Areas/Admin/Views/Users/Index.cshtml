@model IEnumerable<Harmic.Models.TbCustomer>

@{
    ViewData["Title"] = "Quản lý người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewBag.active = "Users";
    var roles = ViewBag.Roles as List<Harmic.Models.TbRole>;
    var search = ViewBag.Search as string ?? "";
    var selectedRoleId = ViewBag.SelectedRoleId as int?;
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Quản lý người dùng</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Home">Trang chủ</a></li>
                        <li class="breadcrumb-item active">Quản lý người dùng</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <!-- Filter và Search -->
            <div class="row mb-3">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <form method="get" action="/Admin/Users" class="row">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Tìm kiếm</label>
                                        <input type="text" name="search" class="form-control" placeholder="Tên, Email, SĐT..." value="@search">
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Lọc theo Role</label>
                                        <select name="roleId" class="form-control">
                                            <option value="">Tất cả</option>
                                            @if (roles != null)
                                            {
                                                @foreach (var role in roles)
                                                {
                                                    var isSelected = selectedRoleId == role.RoleId;
                                                    <option value="@role.RoleId" selected="@isSelected">
                                                        @role.RoleName
                                                    </option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <button type="submit" class="btn btn-primary mr-2">
                                        <i class="fas fa-search"></i> Tìm kiếm
                                    </button>
                                    <a href="/Admin/Users" class="btn btn-secondary">
                                        <i class="fas fa-redo"></i> Reset
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Danh sách người dùng -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                Danh sách người dùng 
                                <span class="badge badge-info">@Model.Count()</span>
                            </h3>
                        </div>
                        <div class="card-body table-responsive p-0">
                            <table class="table table-hover text-nowrap">
                                <thead>
                                    <tr>
                                        <th style="width: 50px;">ID</th>
                                        <th>Tên đăng nhập</th>
                                        <th>Email</th>
                                        <th>Số điện thoại</th>
                                        <th>Role</th>
                                        <th style="width: 180px;">Đổi Role</th>
                                        <th style="width: 120px;">Trạng thái</th>
                                        <th style="width: 150px;">Đăng nhập lần cuối</th>
                                        <th style="width: 100px;">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Any())
                                    {
                                        @foreach (var user in Model)
                                        {
                                            <tr>
                                                <td>@user.CustomerId</td>
                                                <td>
                                                    <strong>@user.Username</strong>
                                                    @if (user.CustomerId == Harmic.Utilities.Function._AccountId)
                                                    {
                                                        <span class="badge badge-warning ml-1">Bạn</span>
                                                    }
                                                </td>
                                                <td>@(user.Email ?? "N/A")</td>
                                                <td>@(user.Phone ?? "N/A")</td>
                                                <td>
                                                    @{
                                                        var roleBadgeClass = user.RoleId switch
                                                        {
                                                            1 => "badge-secondary", // Khách hàng
                                                            2 => "badge-danger",    // Admin
                                                            4 => "badge-success",   // Người bán
                                                            _ => "badge-info"
                                                        };
                                                    }
                                                    <span class="badge @roleBadgeClass">
                                                        @(user.Role?.RoleName ?? "N/A")
                                                    </span>
                                                </td>
                                                <td>
                                                    <select class="form-control form-control-sm role-select" 
                                                            data-user-id="@user.CustomerId" 
                                                            data-original-role-id="@user.RoleId"
                                                            id="roleSelect_@user.CustomerId"
                                                            @{
                                                                if (user.CustomerId == Harmic.Utilities.Function._AccountId)
                                                                {
                                                                    <text>disabled</text>
                                                                }
                                                            }>
                                                        @if (roles != null)
                                                        {
                                                            @foreach (var role in roles)
                                                            {
                                                                var isSelected = user.RoleId == role.RoleId;
                                                                if (isSelected)
                                                                {
                                                                    <option value="@role.RoleId" selected="selected">
                                                                        @role.RoleName
                                                                    </option>
                                                                }
                                                                else
                                                                {
                                                                    <option value="@role.RoleId">
                                                                        @role.RoleName
                                                                    </option>
                                                                }
                                                            }
                                                        }
                                                    </select>
                                                </td>
                                                <td>
                                                    @if (user.IsActive)
                                                    {
                                                        <span class="badge badge-success">Hoạt động</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-danger">Không hoạt động</span>
                                                    }
                                                </td>
                                                <td>@(user.LastLogin?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa đăng nhập")</td>
                                                <td>
                                                    @{
                                                        var btnClass = user.IsActive ? "btn-warning" : "btn-success";
                                                        var btnTitle = user.IsActive ? "Vô hiệu hóa" : "Kích hoạt";
                                                        var btnIcon = user.IsActive ? "fa-ban" : "fa-check";
                                                        var isDisabled = user.CustomerId == Harmic.Utilities.Function._AccountId;
                                                    }
                                                    <button class="btn btn-sm btn-toggle-active @btnClass" 
                                                            data-user-id="@user.CustomerId"
                                                            @if (isDisabled) { <text>disabled</text> }
                                                            title="@btnTitle">
                                                        <i class="fas @btnIcon"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="9" class="text-center">
                                                <p class="text-muted mt-3">Không tìm thấy người dùng nào</p>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer">
                            <button type="button" id="btnSaveAllRoles" class="btn btn-success">
                                <i class="fas fa-save"></i> Lưu tất cả thay đổi role
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Xử lý click button Lưu tất cả
            $('#btnSaveAllRoles').on('click', function() {
                var btn = $(this);
                var changes = [];
                
                // Thu thập tất cả các thay đổi role
                $('.role-select').each(function() {
                    var select = $(this);
                    var userId = select.data('user-id');
                    var originalRoleId = select.data('original-role-id');
                    var currentRoleId = select.val();
                    
                    // Lưu giá trị gốc nếu chưa có
                    if (!originalRoleId) {
                        var savedOriginal = select.attr('data-original-role-id') || select.find('option[selected]').val() || select.val();
                        select.data('original-role-id', savedOriginal);
                        originalRoleId = savedOriginal;
                    }
                    
                    // Nếu có thay đổi, thêm vào danh sách
                    if (currentRoleId != originalRoleId) {
                        changes.push({
                            userId: userId,
                            roleId: currentRoleId,
                            originalRoleId: originalRoleId,
                            select: select
                        });
                    }
                });
                
                // Nếu không có thay đổi nào
                if (changes.length === 0) {
                    showWarningDialog('Không có thay đổi nào để lưu!');
                    return;
                }
                
                // Disable button
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang lưu...');
                
                // Lưu từng thay đổi
                var savePromises = [];
                var successCount = 0;
                var errorCount = 0;
                var errorMessages = [];
                
                changes.forEach(function(change) {
                    var promise = $.ajax({
                        url: '/Admin/Users/ChangeRole',
                        type: 'POST',
                        dataType: 'json',
                        data: {
                            userId: change.userId,
                            roleId: change.roleId
                        }
                    }).then(function(response) {
                        if (response && response.success) {
                            successCount++;
                            // Cập nhật original role id
                            change.select.data('original-role-id', change.roleId);
                        } else {
                            errorCount++;
                            errorMessages.push(response ? response.message : 'Lỗi không xác định');
                        }
                    }).catch(function(xhr) {
                        errorCount++;
                        var errorMsg = 'Có lỗi xảy ra';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        }
                        errorMessages.push(errorMsg);
                    });
                    
                    savePromises.push(promise);
                });
                
                // Đợi tất cả các request hoàn thành
                Promise.all(savePromises).then(function() {
                    btn.prop('disabled', false).html('<i class="fas fa-save"></i> Lưu tất cả thay đổi role');
                    
                    console.log('Save completed. Success:', successCount, 'Errors:', errorCount);
                    
                    // Hiển thị kết quả
                    if (errorCount === 0) {
                        // Tất cả thành công - hiển thị dialog trực tiếp
                        var message = 'Đã lưu thành công ' + successCount + ' thay đổi role!';
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: message,
                            confirmButtonText: 'Đóng',
                            confirmButtonColor: '#28a745'
                        }).then((result) => {
                            location.reload();
                        });
                    } else if (successCount > 0) {
                        // Một số thành công, một số lỗi
                        Swal.fire({
                            icon: 'warning',
                            title: 'Cảnh báo',
                            text: 'Đã lưu thành công ' + successCount + ' thay đổi. Có ' + errorCount + ' lỗi xảy ra.',
                            confirmButtonText: 'Đóng',
                            confirmButtonColor: '#ffc107'
                        });
                    } else {
                        // Tất cả đều lỗi
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: 'Có lỗi xảy ra khi lưu: ' + errorMessages.join(', '),
                            confirmButtonText: 'Đóng',
                            confirmButtonColor: '#dc3545'
                        });
                    }
                }).catch(function(error) {
                    console.error('Error in Promise.all:', error);
                    btn.prop('disabled', false).html('<i class="fas fa-save"></i> Lưu tất cả thay đổi role');
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Có lỗi xảy ra khi lưu!',
                        confirmButtonText: 'Đóng',
                        confirmButtonColor: '#dc3545'
                    });
                });
            });

            // Toggle active status
            $('.btn-toggle-active').on('click', function() {
                var userId = $(this).data('user-id');
                var btn = $(this);
                var isActive = btn.hasClass('btn-warning');

                var confirmMessage = isActive 
                    ? 'Bạn có chắc muốn vô hiệu hóa tài khoản này?' 
                    : 'Bạn có chắc muốn kích hoạt tài khoản này?';

                Swal.fire({
                    icon: 'question',
                    title: 'Xác nhận',
                    text: confirmMessage,
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy',
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33'
                }).then((result) => {
                    if (!result.isConfirmed) {
                        return;
                    }

                    btn.prop('disabled', true);

                    $.ajax({
                        url: '/Admin/Users/ToggleActive',
                        type: 'POST',
                        data: {
                            userId: userId
                        },
                        success: function(response) {
                            if (response.success) {
                                showSuccessDialog(response.message, function() {
                                    location.reload();
                                });
                            } else {
                                showErrorDialog(response.message, function() {
                                    btn.prop('disabled', false);
                                });
                            }
                        },
                        error: function() {
                            showErrorDialog('Có lỗi xảy ra khi cập nhật trạng thái!', function() {
                                btn.prop('disabled', false);
                            });
                        }
                    });
                });
            });
        });
    </script>
}
