	<!-- SweetAlert2 -->
	<script src="~/admin/plugins/sweetalert2/sweetalert2.min.js"></script>

	<script>
		// Intercept các click vào link action để kiểm tra quyền
		// Đăng ký event handler sớm để bắt được tất cả các click
		$(document).on('click', 'a[href*="/Admin/"]', function(e) {
				var link = $(this);
				var href = link.attr('href');
				
				// Bỏ qua các link đặc biệt
				if (link.hasClass('no-permission-check') || 
					link.attr('target') === '_blank' ||
					!href || href === '#' || href.includes('javascript:') || href.includes('mailto:') || href.includes('tel:')) {
					return true;
				}
				
				// Bỏ qua các link Details, Chi tiết, Xem (chỉ đọc) - nhưng chỉ khi không phải là menu link
				var linkText = link.text().toLowerCase().trim();
				var isMenuLink = link.closest('.nav-sidebar, .nav-treeview').length > 0;
				
				if (!isMenuLink && (linkText === 'chi tiết' || linkText === 'xem' || linkText === 'details' || 
					href.includes('/Details') || href.includes('/details'))) {
					return true;
				}
				
				// Bỏ qua link Index nếu không phải menu link
				if (!isMenuLink && href.includes('/Index')) {
					return true;
				}
				
				// Bỏ qua các link có class đặc biệt (như delete-permission-btn sẽ tự xử lý)
				if (link.hasClass('delete-permission-btn') || link.hasClass('delete-category-btn') || link.hasClass('delete-btn')) {
					return true; // Cho phép link tự xử lý
				}
				
				// Kiểm tra xem link có phải là action cần quyền không
				// Hoặc là menu link (cần kiểm tra quyền)
				if (isMenuLink || href.includes('/Create') || href.includes('/Edit') || 
					href.includes('/Delete') || href.includes('/ChangeShow') ||
					href.includes('/MoveUp') || href.includes('/MoveDown') ||
					href.includes('/Permissions') || href.includes('/Users') || 
					href.includes('/RolePermissions')) {
					
					e.preventDefault();
					e.stopPropagation();
					
					// Gọi AJAX để kiểm tra quyền
					// Lưu URL hiện tại để kiểm tra sau
					var currentPath = window.location.pathname;
					
					$.ajax({
						url: href,
						type: 'GET',
						timeout: 5000,
						headers: {
							'X-Requested-With': 'XMLHttpRequest'
						},
						success: function(data, textStatus, xhr) {
							// Kiểm tra xem response có phải là JSON không
							var jsonData = null;
							try {
								if (typeof data === 'string') {
									jsonData = JSON.parse(data);
								} else if (typeof data === 'object' && data !== null) {
									jsonData = data;
								}
							} catch(e) {
								// Không phải JSON, có thể là HTML page
							}
							
							// Nếu là JSON và có message không có quyền
							if (jsonData && jsonData.message && !jsonData.success) {
								showPermissionDeniedDialog();
								return;
							}
							
							// Kiểm tra xem response HTML có chứa thông báo không có quyền không
							// Hoặc nếu response là HTML của trang Home (có thể do redirect)
							if (typeof data === 'string') {
								// Kiểm tra xem có phải là trang Home không (có thể do redirect)
								if (data.includes('không có quyền') || 
									data.includes('Bạn không có quyền') ||
									data.includes('permission denied') ||
									(data.includes('Harmic') && data.includes('Trang chủ') && currentPath.includes('/Admin'))) {
									showPermissionDeniedDialog();
									return;
								}
							}
							
							// Cho phép navigate
							window.location.href = href;
						},
						error: function(xhr, status, error) {
							// Nếu response là JSON (parse được)
							try {
								if (xhr.responseText) {
									var jsonData = JSON.parse(xhr.responseText);
									if (jsonData && jsonData.message) {
										showPermissionDeniedDialog();
										return;
									}
								}
							} catch(e) {
								// Không phải JSON
							}
							
							// Nếu là lỗi 403, 401
							if (xhr.status === 403 || xhr.status === 401) {
								showPermissionDeniedDialog();
							} else if (xhr.status === 302 || xhr.status === 0 || status === 'timeout') {
								// Có thể là redirect do không có quyền
								// Nếu đang ở trong Admin area và redirect về /Home, hiển thị dialog
								if (window.location.pathname.includes('/Admin')) {
									showPermissionDeniedDialog();
								} else {
									// Nếu không phải redirect về Home, cho phép navigate
									try {
										var location = xhr.getResponseHeader('Location');
										if (location && (location.includes('/Admin/Home') || location.includes('/Home'))) {
											showPermissionDeniedDialog();
										} else {
											window.location.href = href;
										}
									} catch(e) {
										// Nếu không lấy được Location header và đang ở Admin, hiển thị dialog
										if (window.location.pathname.includes('/Admin')) {
											showPermissionDeniedDialog();
										} else {
											window.location.href = href;
										}
									}
								}
							} else {
								// Nếu lỗi khác, vẫn cho phép navigate
								window.location.href = href;
							}
						}
					});
					
					return false;
				}
		});
		
		// Bắt các form submit (như Delete)
		$(document).on('submit', 'form[action*="/Admin/"]', function(e) {
				var form = $(this);
				var action = form.attr('action');
				
				if (action && (action.includes('/Delete') || action.includes('/delete'))) {
					e.preventDefault();
					
					// Kiểm tra quyền trước khi submit
					$.ajax({
						url: action,
						type: 'GET',
						timeout: 5000,
						headers: {
							'X-Requested-With': 'XMLHttpRequest'
						},
						success: function(data, textStatus, xhr) {
							// Kiểm tra xem response có phải là JSON không
							var jsonData = null;
							try {
								if (typeof data === 'string') {
									jsonData = JSON.parse(data);
								} else if (typeof data === 'object') {
									jsonData = data;
								}
							} catch(e) {
								// Không phải JSON
							}
							
							if (jsonData && jsonData.message && !jsonData.success) {
								showPermissionDeniedDialog();
							} else {
								// Cho phép submit form
								form.off('submit').submit();
							}
						},
						error: function(xhr, status, error) {
							// Nếu response là JSON
							try {
								var jsonData = JSON.parse(xhr.responseText);
								if (jsonData && jsonData.message) {
									showPermissionDeniedDialog();
									return;
								}
							} catch(e) {
								// Không phải JSON
							}
							
							if (xhr.status === 403 || xhr.status === 401) {
								showPermissionDeniedDialog();
							} else {
								// Cho phép submit form
								form.off('submit').submit();
							}
						}
					});
					
					return false;
				}
			});
		});
		
		// Hàm hiển thị dialog không có quyền
		function showPermissionDeniedDialog() {
			Swal.fire({
				icon: 'warning',
				title: 'Không có quyền',
				text: 'Bạn không có quyền thực hiện chức năng này. Vui lòng liên hệ quản trị viên để được cấp quyền.',
				confirmButtonText: 'Đóng',
				confirmButtonColor: '#3085d6',
				allowOutsideClick: false,
				allowEscapeKey: true
			});
		}
		
		// Helper functions để thay thế alert() và confirm()
		// Thay thế window.alert
		window.alert = function(message) {
			Swal.fire({
				icon: 'info',
				title: 'Thông báo',
				text: message,
				confirmButtonText: 'Đóng',
				confirmButtonColor: '#3085d6'
			});
		};
		
		// Helper function để confirm với SweetAlert2 (async)
		function confirmDialog(message) {
			return Swal.fire({
				icon: 'question',
				title: 'Xác nhận',
				text: message,
				showCancelButton: true,
				confirmButtonText: 'Đồng ý',
				cancelButtonText: 'Hủy',
				confirmButtonColor: '#3085d6',
				cancelButtonColor: '#d33'
			}).then((result) => {
				return result.isConfirmed;
			});
		}
		
		// Helper function để hiển thị thông báo thành công
		function showSuccessDialog(message, callback) {
			Swal.fire({
				icon: 'success',
				title: 'Thành công',
				text: message,
				confirmButtonText: 'Đóng',
				confirmButtonColor: '#28a745'
			}).then((result) => {
				if (callback) callback();
			});
		}
		
		// Helper function để hiển thị thông báo lỗi
		function showErrorDialog(message, callback) {
			Swal.fire({
				icon: 'error',
				title: 'Lỗi',
				text: message,
				confirmButtonText: 'Đóng',
				confirmButtonColor: '#dc3545'
			}).then((result) => {
				if (callback) callback();
			});
		}
		
		// Helper function để hiển thị thông báo cảnh báo
		function showWarningDialog(message, callback) {
			Swal.fire({
				icon: 'warning',
				title: 'Cảnh báo',
				text: message,
				confirmButtonText: 'Đóng',
				confirmButtonColor: '#ffc107'
			}).then((result) => {
				if (callback) callback();
			});
		}
	</script>

	@RenderSection("Scripts", required: false)

</body>
