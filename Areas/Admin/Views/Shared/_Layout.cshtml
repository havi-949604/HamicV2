<body class="hold-transition sidebar-mini layout-fixed">


 @if (!string.IsNullOrEmpty(Function._Message))
    {
        var message = Function._Message;
        var messageType = "info";
        var messageTitle = "Thông báo";
        var messageIcon = "fa-info-circle";
        
        if (message.Contains("thành công") || message.Contains("success"))
        {
            messageType = "success";
            messageTitle = "Thành công";
            messageIcon = "fa-check-circle";
        }
        else if (message.Contains("lỗi") || message.Contains("error") || message.Contains("thất bại"))
        {
            messageType = "danger";
            messageTitle = "Lỗi";
            messageIcon = "fa-exclamation-circle";
        }
        
        Function._Message = string.Empty;
        
        <div class="modal fade" id="messageModal" tabindex="-1" role="dialog" aria-labelledby="messageModalLabel" aria-hidden="true" data-backdrop="static">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header bg-@messageType">
                        <h5 class="modal-title text-white" id="messageModalLabel">
                            <i class="fas @messageIcon"></i> @messageTitle
                        </h5>
                        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <p>@message</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-@messageType" data-dismiss="modal">Đóng</button>
                    </div>
                </div>
            </div>
        </div>
        <script>
            $(document).ready(function() {
                $('#messageModal').modal('show');
            });
        </script>
    }

