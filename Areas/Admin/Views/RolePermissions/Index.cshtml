@model IEnumerable<Harmic.Models.TbRolePermission>

@{
    ViewData["Title"] = "Danh sách phân quyền";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewBag.active = "RolePermissions";
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Danh sách phân quyền</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Home">Trang chủ</a></li>
                        <li class="breadcrumb-item active">Danh sách phân quyền</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Phân quyền đã được gán</h3>
                            <div class="card-tools">
                                <a href="/Admin/RolePermissions/Manage" class="btn btn-primary btn-sm">
                                    <i class="fas fa-plus"></i> Phân quyền mới
                                </a>
                            </div>
                        </div>
                        <div class="card-body table-responsive p-0">
                            <table class="table table-hover text-nowrap">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Role</th>
                                        <th>Quyền</th>
                                        <th>Controller</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.RolePermissionId</td>
                                                <td>@(item.Role?.RoleName ?? "N/A")</td>
                                                <td>@(item.Permission?.PermissionName ?? "N/A")</td>
                                                <td>@(item.Permission?.ControllerName ?? "N/A")</td>
                                                <td>@(item.Permission?.ActionName ?? "N/A")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center">Chưa có phân quyền nào. <a href="/Admin/RolePermissions/Manage">Phân quyền ngay</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

